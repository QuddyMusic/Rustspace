# Исходники всегда с LF, в том числе в Windows-клоне (rustfmt: newline_style = "Unix").
* text=auto eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.json text eol=lf
# Двоичные файлы — как есть.
*.png binary
*.ico binary
*.webp binary
*.gif binary
*.jpg binary
*.ttf binary
*.otf binary
*.wasm binary
*.ogg binary
